# Copy to .env and fill in your local values. Never commit .env.
# Load before starting the backend: set -a && source .env && set +a

DATABASE_URL=jdbc:postgresql://localhost:5432/staffmatch_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# Required — at least 32 characters
JWT_SECRET=

# Optional
# JPA_DDL_AUTO=validate
# MATCHING_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# MATCHING_ENABLED=true
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# ADMIN_SEED_ENABLED=true
# ADMIN_SEED_EMAIL=admin@example.com
# ADMIN_SEED_PASSWORD=
# MATCHING_PROVIDER=n8n
# N8N_MATCHING_ENABLED=true
# N8N_WEBHOOK_SECRET=
