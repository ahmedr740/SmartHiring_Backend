# Copy to .env.production on the Lightsail server. Never commit the real file.
DOMAIN=example.com
TLS_EMAIL=owner@example.com

# Generate independent high-entropy values. Do not reuse secrets.
POSTGRES_ADMIN_PASSWORD=replace-with-a-long-random-value
STAFFMATCH_DB_PASSWORD=replace-with-a-different-long-random-value
N8N_DB_PASSWORD=replace-with-a-different-long-random-value
JWT_SECRET=replace-with-at-least-32-random-characters
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value-and-keep-it-safe
N8N_WEBHOOK_SECRET=replace-with-a-different-long-random-value

# Protects the n8n editor. Generate the hash with:
# docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'YOUR_PASSWORD'
N8N_PROXY_USER=owner
N8N_PROXY_PASSWORD_HASH='$2a$14$replace_with_the_generated_caddy_hash'

# Enable only for the first start if an administrator must be seeded.
ADMIN_SEED_ENABLED=false
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-with-a-strong-password

# Enable only after the hosted Gmail workflow is configured and tested.
N8N_NOTIFICATION_ENABLED=false
